# k6 Load Testing Environment Variables

# API Configuration
API_URL=http://localhost:5001
WS_URL=ws://localhost:5001
ENVIRONMENT=development

# Test Configuration
CONCURRENT_USERS=50
TEST_DURATION=15m
RAMP_UP_DURATION=5m
RAMP_DOWN_DURATION=2m

# Authentication
TEST_USER_PREFIX=test_user_
TEST_USER_PASSWORD=test123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database (for test data generation)
DATABASE_URL=postgresql://user:password@localhost:5432/dify_test

# Performance Thresholds Override
MAX_RESPONSE_TIME_P90=3000
MAX_RESPONSE_TIME_P95=5000
MAX_LLM_RESPONSE_TIME=30000
MAX_ERROR_RATE=0.01

# Resource Monitoring
MONITOR_CPU_USAGE=true
MONITOR_MEMORY_USAGE=true
MONITOR_NETWORK_IO=true

# Reporting
GENERATE_HTML_REPORT=true
EXPORT_GRAFANA_METRICS=false
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your_api_key_here

# WebSocket Testing
WEBSOCKET_CONNECTION_TIMEOUT=5000
WEBSOCKET_MESSAGE_INTERVAL=1000
WEBSOCKET_MAX_CONNECTIONS=100

# File Upload Testing
SAMPLE_FILE_SIZE_KB=100
MAX_FILE_UPLOAD_SIZE_MB=10
TEST_FILE_TYPES=txt,pdf,docx,md

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# Stress Testing
STRESS_TEST_MAX_USERS=200
STRESS_TEST_DURATION=10m
FAILURE_THRESHOLD_PERCENT=5

# Auto-scaling Testing
AUTOSCALE_CPU_THRESHOLD=80
AUTOSCALE_MEMORY_THRESHOLD=2048
AUTOSCALE_TRIGGER_DURATION=300