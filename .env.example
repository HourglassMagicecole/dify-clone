# Copy this file to .env.development and update with your values
# Development environment configuration

# API Configuration
FLASK_APP=app
FLASK_ENV=development
FLASK_DEBUG=True
API_PORT=5001
API_HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dify_edu_dev
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage

# Education Features
EDUCATION_MODE=true
EDUCATION_MAX_STUDENTS_PER_CLASS=50
EDUCATION_TRIAL_DURATION=30

# Dify Integration
DIFY_API_URL=http://localhost:3000
DIFY_API_KEY=your_dify_api_key_here

# Security
SECRET_KEY=change_this_in_production
INIT_PASSWORD=change_me

# Logging
LOG_LEVEL=DEBUG
ENABLE_REQUEST_LOGGING=true
LOG_FILE=/app/logs/dify.log

# Development Features
MIGRATION_ENABLED=true
CHECK_UPDATE_URL=

# OpenAI Configuration (Development)
OPENAI_API_KEY=your-openai-api-key-here

# Other API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
GOOGLE_API_KEY=your_google_key_here

# Development Tools
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true