# Development Environment Configuration
# This file contains development-specific environment variables

# Environment
ENVIRONMENT=development
NODE_ENV=development
FLASK_ENV=development
DEBUG=true
FLASK_DEBUG=true

# Application URLs
CONSOLE_API_URL=http://localhost:5001
CONSOLE_WEB_URL=http://localhost:3000
SERVICE_API_URL=http://localhost:5001
APP_API_URL=http://localhost:5001/api
APP_WEB_URL=http://localhost:3000
FILES_URL=http://localhost:5001/files

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=dify_dev
DB_USERNAME=postgres
DB_PASSWORD=dify123456

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1

# Security
SECRET_KEY=dev-secret-key-change-in-production-9f73s3lj
INIT_PASSWORD=password123

# Logging
LOG_LEVEL=DEBUG
ENABLE_REQUEST_LOGGING=true
LOG_FILE=/app/logs/dify.log

# Development Features
MIGRATION_ENABLED=true
CHECK_UPDATE_URL=

# OpenAI Configuration (Development)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# Educational Platform Configuration
EDU_SESSION_SECRET=dev-edu-session-secret-key
EDU_MAX_USERS=10
EDU_MAX_CONCURRENT_REQUESTS=20
EDU_API_RATE_LIMIT=500
EDU_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Web-EDU Configuration
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_WEB_URL=http://localhost:3001
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3000

# Development Tools
REACT_EDITOR=code
BROWSER=chrome

# Testing
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_DATABASE=dify_test
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=dify123456

# File Storage (Development)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage

# Email (Development - Console output)
MAIL_TYPE=console
MAIL_DEFAULT_SEND_FROM=noreply@dev.dify.ai

# Sentry (Disabled in development)
SENTRY_DSN=

# Performance Monitoring (Disabled in development)
ENABLE_PROFILING=false
ENABLE_METRICS=false

# Docker Image Tags (Development)
API_IMAGE_TAG=dev
WEB_IMAGE_TAG=dev
WEB_EDU_IMAGE_TAG=dev

# Development Database Seeds
SEED_DATA=true
CREATE_SAMPLE_USERS=true