# Staging Environment Configuration
# This file contains staging-specific environment variables

# Environment
ENVIRONMENT=staging
NODE_ENV=production
FLASK_ENV=production
DEBUG=false
FLASK_DEBUG=false

# Application URLs
CONSOLE_API_URL=https://staging-api.dify.example.com
CONSOLE_WEB_URL=https://staging.dify.example.com
SERVICE_API_URL=https://staging-api.dify.example.com
APP_API_URL=https://staging-api.dify.example.com/api
APP_WEB_URL=https://staging.dify.example.com
FILES_URL=https://staging-api.dify.example.com/files

# Database Configuration
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT:-5432}
DB_DATABASE=${DB_DATABASE}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

# Redis Configuration
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT:-6379}
REDIS_DB=${REDIS_DB:-0}
REDIS_PASSWORD=${REDIS_PASSWORD}

# Celery Configuration
CELERY_BROKER_URL=${CELERY_BROKER_URL}

# Security
SECRET_KEY=${SECRET_KEY}
INIT_PASSWORD=${INIT_PASSWORD}

# Logging
LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=false
LOG_FILE=/app/logs/dify.log

# Features
MIGRATION_ENABLED=true
CHECK_UPDATE_URL=https://updates.dify.ai

# OpenAI Configuration
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_API_BASE=${OPENAI_API_BASE:-https://api.openai.com/v1}

# Educational Platform Configuration
EDU_SESSION_SECRET=${EDU_SESSION_SECRET}
EDU_MAX_USERS=25
EDU_MAX_CONCURRENT_REQUESTS=35
EDU_API_RATE_LIMIT=750
EDU_CORS_ORIGINS=${EDU_CORS_ORIGINS}

# Web-EDU Configuration
NEXT_PUBLIC_API_URL=https://staging-api.dify.example.com
NEXT_PUBLIC_WEB_URL=https://staging-edu.dify.example.com
NEXT_PUBLIC_CONSOLE_URL=https://staging.dify.example.com

# Testing Configuration
TEST_DB_HOST=${TEST_DB_HOST}
TEST_DB_PORT=${TEST_DB_PORT:-5432}
TEST_DB_DATABASE=${TEST_DB_DATABASE}
TEST_DB_USERNAME=${TEST_DB_USERNAME}
TEST_DB_PASSWORD=${TEST_DB_PASSWORD}

# File Storage
STORAGE_TYPE=${STORAGE_TYPE:-s3}
STORAGE_S3_BUCKET=${STORAGE_S3_BUCKET}
STORAGE_S3_REGION=${STORAGE_S3_REGION}
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}

# Email Configuration
MAIL_TYPE=${MAIL_TYPE:-smtp}
MAIL_DEFAULT_SEND_FROM=${MAIL_DEFAULT_SEND_FROM}
SMTP_SERVER=${SMTP_SERVER}
SMTP_PORT=${SMTP_PORT:-587}
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_USE_TLS=${SMTP_USE_TLS:-true}

# Monitoring and Analytics
SENTRY_DSN=${SENTRY_DSN}
ENABLE_PROFILING=false
ENABLE_METRICS=true

# Performance Settings
GUNICORN_TIMEOUT=200
SERVER_WORKER_AMOUNT=2
CELERY_WORKER_AMOUNT=2

# Docker Image Tags
API_IMAGE_TAG=${API_IMAGE_TAG:-staging}
WEB_IMAGE_TAG=${WEB_IMAGE_TAG:-staging}
WEB_EDU_IMAGE_TAG=${WEB_EDU_IMAGE_TAG:-staging}

# SSL Configuration
FORCE_HTTPS=true
SECURE_COOKIES=true

# Rate Limiting
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=1000
API_RATE_LIMIT_WINDOW=3600

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_ENDPOINT=/health

# Staging-specific Features
ENABLE_STAGING_BANNER=true
STAGING_WARNING_MESSAGE="This is a staging environment"

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=14

# Cache Configuration
ENABLE_REDIS_CACHE=true
CACHE_DEFAULT_TTL=3600