# Production Environment Configuration
# This file contains production-specific environment variables
# IMPORTANT: Replace all placeholder values with actual production values

# Environment
ENVIRONMENT=production
NODE_ENV=production
FLASK_ENV=production
DEBUG=false
FLASK_DEBUG=false

# Application URLs
CONSOLE_API_URL=${CONSOLE_API_URL}
CONSOLE_WEB_URL=${CONSOLE_WEB_URL}
SERVICE_API_URL=${SERVICE_API_URL}
APP_API_URL=${APP_API_URL}
APP_WEB_URL=${APP_WEB_URL}
FILES_URL=${FILES_URL}

# Database Configuration
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT:-5432}
DB_DATABASE=${DB_DATABASE}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

# Redis Configuration
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT:-6379}
REDIS_DB=${REDIS_DB:-0}
REDIS_PASSWORD=${REDIS_PASSWORD}

# Celery Configuration
CELERY_BROKER_URL=${CELERY_BROKER_URL}

# Security
SECRET_KEY=${SECRET_KEY}
INIT_PASSWORD=${INIT_PASSWORD}

# Logging
LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=false
LOG_FILE=/app/logs/dify.log
LOG_FILE_MAX_SIZE=50
LOG_FILE_BACKUP_COUNT=10

# Features
MIGRATION_ENABLED=true
CHECK_UPDATE_URL=https://updates.dify.ai

# OpenAI Configuration
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_API_BASE=${OPENAI_API_BASE:-https://api.openai.com/v1}

# Educational Platform Configuration
EDU_SESSION_SECRET=${EDU_SESSION_SECRET}
EDU_MAX_USERS=${EDU_MAX_USERS:-50}
EDU_MAX_CONCURRENT_REQUESTS=${EDU_MAX_CONCURRENT_REQUESTS:-50}
EDU_API_RATE_LIMIT=${EDU_API_RATE_LIMIT:-1000}
EDU_CORS_ORIGINS=${EDU_CORS_ORIGINS}

# Web-EDU Configuration
NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
NEXT_PUBLIC_WEB_URL=${NEXT_PUBLIC_WEB_URL}
NEXT_PUBLIC_CONSOLE_URL=${NEXT_PUBLIC_CONSOLE_URL}

# File Storage
STORAGE_TYPE=${STORAGE_TYPE}
STORAGE_S3_BUCKET=${STORAGE_S3_BUCKET}
STORAGE_S3_REGION=${STORAGE_S3_REGION}
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}

# Email Configuration
MAIL_TYPE=${MAIL_TYPE}
MAIL_DEFAULT_SEND_FROM=${MAIL_DEFAULT_SEND_FROM}
SMTP_SERVER=${SMTP_SERVER}
SMTP_PORT=${SMTP_PORT:-587}
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_USE_TLS=${SMTP_USE_TLS:-true}

# Monitoring and Analytics
SENTRY_DSN=${SENTRY_DSN}
ENABLE_PROFILING=false
ENABLE_METRICS=true

# Performance Settings
GUNICORN_TIMEOUT=${GUNICORN_TIMEOUT:-360}
SERVER_WORKER_AMOUNT=${SERVER_WORKER_AMOUNT:-4}
SERVER_WORKER_CONNECTIONS=${SERVER_WORKER_CONNECTIONS:-1000}
CELERY_WORKER_AMOUNT=${CELERY_WORKER_AMOUNT:-4}

# Docker Image Tags
API_IMAGE_TAG=${API_IMAGE_TAG:-latest}
WEB_IMAGE_TAG=${WEB_IMAGE_TAG:-latest}
WEB_EDU_IMAGE_TAG=${WEB_EDU_IMAGE_TAG:-latest}

# SSL Configuration
FORCE_HTTPS=true
SECURE_COOKIES=true
SECURE_SSL_REDIRECT=true

# Rate Limiting
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=${API_RATE_LIMIT_REQUESTS:-5000}
API_RATE_LIMIT_WINDOW=${API_RATE_LIMIT_WINDOW:-3600}

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_ENDPOINT=/health

# Security Headers
ENABLE_SECURITY_HEADERS=true
CONTENT_SECURITY_POLICY=${CONTENT_SECURITY_POLICY}

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=${BACKUP_SCHEDULE:-"0 2 * * *"}  # Daily at 2 AM
BACKUP_RETENTION_DAYS=${BACKUP_RETENTION_DAYS:-30}
BACKUP_S3_BUCKET=${BACKUP_S3_BUCKET}

# Cache Configuration
ENABLE_REDIS_CACHE=true
CACHE_DEFAULT_TTL=${CACHE_DEFAULT_TTL:-7200}

# CDN Configuration
CDN_ENABLED=${CDN_ENABLED:-false}
CDN_DOMAIN=${CDN_DOMAIN}

# Database Connection Pool
DB_POOL_SIZE=${DB_POOL_SIZE:-20}
DB_MAX_OVERFLOW=${DB_MAX_OVERFLOW:-30}
DB_POOL_TIMEOUT=${DB_POOL_TIMEOUT:-30}

# Session Configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# CORS Configuration
CORS_ALLOW_ORIGINS=${CORS_ALLOW_ORIGINS}
CORS_ALLOW_CREDENTIALS=true

# WebSocket Configuration
WEBSOCKET_ENABLED=${WEBSOCKET_ENABLED:-true}
WEBSOCKET_PATH=${WEBSOCKET_PATH:-/ws}

# Feature Flags
FEATURE_ADVANCED_ANALYTICS=${FEATURE_ADVANCED_ANALYTICS:-true}
FEATURE_CUSTOM_BRANDING=${FEATURE_CUSTOM_BRANDING:-true}
FEATURE_API_THROTTLING=${FEATURE_API_THROTTLING:-true}

# Compliance
DATA_RETENTION_DAYS=${DATA_RETENTION_DAYS:-365}
GDPR_COMPLIANCE_ENABLED=${GDPR_COMPLIANCE_ENABLED:-true}
AUDIT_LOGGING_ENABLED=${AUDIT_LOGGING_ENABLED:-true}